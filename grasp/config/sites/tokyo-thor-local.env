# 東京の台車で、計算も全部 Thor の中で動かすときの値（2026-11-21 Sota・Claude Code）。北九州の kitakyushu-collect.env と同じ 1 台の形。
# Thor で: cd ~/projects/openarm-grasp && set -a && . grasp/config/sites/tokyo-thor-local.env && set +a
# PC からは grasp/tools/pc_thor.sh が ssh でこれを読んでから打つ。サーバーは grasp/tools/thor_servers.sh start
GRASP_SITE=tokyo-thor
GRASP_ROBOT_HOST=local
GRASP_CAMERA_PY=/usr/bin/python3
GRASP_CHEST_SERIAL=344422070898
GRASP_WRIST_SERIAL=409122272149
GRASP_CAN_PORT=can_fol_l
GRASP_ROBOT_ID=follower_left
GRASP_GRIPPER_JSON=$HOME/projects/openarm-grasp/grasp/config/openarm_left_gripper.json
GRASP_SWEEP_JSON=$HOME/projects/openarm-grasp/grasp/config/openarm_custom_hand_sweep.json
GRASP_GRIPPER_OPEN=-60
GRASP_GRIPPER_CLOSE=2
GRASP_T_BASE_CAM=$HOME/projects/openarm-grasp/grasp/config/T_base_cam.json
GRASP_FLOOR_Z=0.28
GRASP_REST=20.3,-3.6,-0.9,92.8,-2.5,-11.0,22.7
GRASP_WORLD_YML=$HOME/projects/openarm-grasp/grasp/config/sites/tokyo-thor.world.yml
GRASP_CUROBO_PORT=5559
GRASP_CUROBO=localhost:5559
OPENARM_REPO=$HOME/projects/openarm-grasp
